{
  "manifest_version": 3,
  "name": "DeveloperOS \u2014 Developer Activity Tracker",
  "version": "1.1.0",
  "description": "Tracks your coding activity on GitHub, LeetCode, GeeksforGeeks, HackerRank, Codeforces and Stack Overflow and syncs it to your DeveloperOS dashboard.",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://leetcode.com/*",
    "https://www.hackerrank.com/*",
    "https://codeforces.com/*",
    "https://www.geeksforgeeks.org/*",
    "https://stackoverflow.com/*",
    "https://developer.mozilla.org/*",
    "https://reactjs.org/*",
    "https://nextjs.org/*",
    "https://docs.python.org/*",
    "https://nodejs.org/*",
    "http://localhost:6500/*",
    "http://127.0.0.1:6500/*",
    "https://api.developeros.page/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content/github.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "content/leetcode.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.hackerrank.com/*"
      ],
      "js": [
        "content/hackerrank.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://codeforces.com/*"
      ],
      "js": [
        "content/codeforces.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.geeksforgeeks.org/*"
      ],
      "js": [
        "content/gfg.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://stackoverflow.com/*"
      ],
      "js": [
        "content/stackoverflow.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://developer.mozilla.org/*",
        "https://reactjs.org/*",
        "https://nextjs.org/*",
        "https://docs.python.org/*",
        "https://nodejs.org/*"
      ],
      "js": [
        "content/docs.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PersonalOS Activity Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/leetcode-inject.js"
      ],
      "matches": [
        "https://leetcode.com/*"
      ]
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "homepage_url": "https://developeros.page"
}
