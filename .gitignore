# =============================================================================
# DeveloperOS — Root .gitignore
# =============================================================================

# ------- Dependencies -------
node_modules/
.pnp
.pnp.js

# ------- Environment variables (NEVER commit secrets) -------
.env
.env.local
.env.*.local
*.env

# ------- Build outputs -------
dist/
dist-ssr/
build/
out/

# ------- TypeScript compiled output -------
backend/dist/

# ------- Logs -------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------- OS generated files -------
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# ------- Editor / IDE -------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------- Testing -------
coverage/

# ------- Miscellaneous -------
*.local
*.tsbuildinfo
