# =============================================================================
# DeveloperOS Root Environment Configuration Example (For Docker Compose)
# Copy this file to .env before running `docker-compose up`
# =============================================================================

# Backend Configuration
PORT=6500
NODE_ENV=production
MONGO_URI=mongodb://mongo:27017/developer-os
JWT_SECRET=super_secure_docker_jwt_secret_key_1234567890
FRONTEND_URL=http://localhost:6501

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Frontend Configuration
VITE_API_URL=http://localhost:6500
