# ============================================================================
# DeveloperOS — environment template
#
# Copy to .env and fill in the values. .env is git-ignored: never commit it.
# Each service also reads its own file when run without Docker:
#   fastapi-backend/.env  and  chat-service/.env  (same JWT_SECRET in both)
# ============================================================================

# --- Required ----------------------------------------------------------------
# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_long_random_secret

# --- Database ----------------------------------------------------------------
# Empty = use the MongoDB container that docker compose starts.
# For MongoDB Atlas put the connection string here (URL-encode special characters in the password).
DOCKER_MONGO_URI=
MONGO_DB_NAME=personalos

# --- Application ---------------------------------------------------------------
APP_ENV=development
FRONTEND_URL=http://localhost:6501
# CORS_ORIGINS=https://app.example.com     # extra browser origins, comma-separated
# Browser-facing API URLs (compiled into the frontend; change for a public deployment)
PUBLIC_API_URL=http://localhost:6500
PUBLIC_CHAT_API_URL=http://localhost:6502

# --- AI ------------------------------------------------------------------------
# Needed for the chatbot and AI-written insights. Without it, those fall back / show an error.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# CHAT_PER_MINUTE=10
# CHAT_PER_DAY=200

# --- GitHub sign-in / repository import (optional) ----------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:6500/api/github/callback

# --- Sign in with Google (optional) --------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:6500/api/auth/google/callback

# --- Email codes for sign-up and password reset (optional) --------------------
# Gmail: smtp.gmail.com, port 587, and an App Password (requires 2-Step Verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
