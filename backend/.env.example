# =============================================================================
# DeveloperOS Backend Environment Configuration Example
# Copy this file to .env and replace the values before running the server.
# =============================================================================

# Server Port
PORT=6500
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/developer-os

# Secure Secret for JWT Token Signing (Generate using `openssl rand -hex 32`)
JWT_SECRET=super_secret_jwt_key_replace_me_in_production_1234567890

# Frontend URL (For CORS Whitelist & OAuth Redirects)
FRONTEND_URL=http://localhost:6501

# GitHub OAuth Credentials (Get from GitHub Developer Settings -> OAuth Apps)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
