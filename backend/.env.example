# =============================================================================
# DeveloperOS — Backend Environment Variables Example
# Copy this file to .env and fill in your own values.
# DO NOT commit .env to version control.
# =============================================================================

# ---- Server ----
PORT=6500
NODE_ENV=development

# ---- MongoDB ----
# Local:   mongodb://localhost:27017/developeros
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/developeros?retryWrites=true&w=majority&appName=Cluster0

# ---- JWT ----
# Generate a strong random secret, e.g.:
#   node -e "require('crypto').randomBytes(64).toString('hex').pipe(process.stdout)"
JWT_SECRET=replace_with_a_long_random_secret

# ---- Frontend URL (used for CORS and OAuth redirects) ----
FRONTEND_URL=http://localhost:6501

# ---- GitHub OAuth App ----
# Create an OAuth App at: https://github.com/settings/developers
# Homepage URL:       http://localhost:6501
# Authorization callback URL: http://localhost:6500/api/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:6500/api/github/callback
